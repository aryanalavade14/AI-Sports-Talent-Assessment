# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# PostgreSQL connection string (user:password@host:port/database)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sports_talent

# Long random string used to sign JWT tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Full URL of the AI teammate's analyze endpoint (used only when MOCK_AI=false)
AI_ENGINE_URL=http://localhost:9000/analyze

# true  = backend generates fake AI results (no AI engine needed)
# false = backend calls AI_ENGINE_URL
MOCK_AI=true

# Where uploaded videos are stored (local storage for now)
UPLOAD_DIR=uploads
MAX_VIDEO_SIZE_MB=50
