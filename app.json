{
  "expo": {
    "name": "SPORTS TALENT AI",
    "slug": "sports-talent-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "sportstalentai",
    "splash": {
      "backgroundColor": "#07111F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sportstalentai.mobile"
    },
    "android": {
      "package": "com.sportstalentai.mobile",
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPORTS TALENT AI to access your camera for performance assessments.",
          "microphonePermission": "Allow SPORTS TALENT AI to use your microphone while recording an assessment.",
          "recordAudioAndroid": true
        }
      ]
    ]
  }
}